rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin(){
      return request.auth != null && request.auth.token.email == 'junior@juelltech.com';
    }

    match /items/{itemId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['title','condition','description','image','reference','postedAt'])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.condition in ['Like New','Good','Well-Loved']
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 2000
                    && request.resource.data.image is string
                    && request.resource.data.image.size() > 0
                    && request.resource.data.image.size() <= 750000
                    && request.resource.data.reference is string
                    && request.resource.data.postedAt == request.time;
      allow update: if isAdmin()
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
                        && request.resource.data.hidden == true);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['text','contact','sentAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && (request.resource.data.contact == null
                          || (request.resource.data.contact is string && request.resource.data.contact.size() <= 200))
                      && request.resource.data.sentAt == request.time;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }
  }
}
